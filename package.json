{
  "private": true,
  "name": "solid-three-monorepo",
  "version": "0.3.0-next.12",
  "description": "SolidJS bindings for ThreeJS - monorepo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solidjs-community/solid-three.git"
  },
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r build",
    "build:dev": "pnpm --filter playground build:dev",
    "clean": "pnpm -r clean && rm -rf .turbo && rm -rf node_modules",
    "dev": "pnpm --filter playground dev",
    "lint": "pnpm --filter solid-three lint",
    "test": "pnpm -r test",
    "prepublishOnly": "pnpm --filter solid-three prepublishOnly"
  },
  "devDependencies": {
    "@solidjs/router": "^0.15.3",
    "@solidjs/testing-library": "^0.8.8",
    "@types/three": "^0.164.1",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "dpdm": "^3.14.0",
    "esbuild": "^0.21.4",
    "esbuild-plugin-solid": "^0.6.0",
    "esbuild-register": "^3.5.0",
    "eslint": "^9.32.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-only-tests": "^3.3.0",
    "jest": "^29.7.0",
    "jiti": "^2.5.1",
    "jsdom": "^24.1.0",
    "remark-gfm": "^3.0.1",
    "rollup": "^4.18.0",
    "rollup-plugin-dts": "^6.1.1",
    "solid-app-router": "^0.1.14",
    "solid-js": "^1.8.17",
    "three": "^0.164.1",
    "three-stdlib": "^2.36.0",
    "tsm": "^2.3.0",
    "tsup": "^8.0.2",
    "tsup-preset-solid": "^2.2.0",
    "typescript": "^5.8.4",
    "vite": "5.2.12",
    "vite-plugin-inspect": "0.8.4",
    "vite-plugin-solid": "2.10.2",
    "vitest": "^1.6.0"
  }
}
