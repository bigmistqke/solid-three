{
  "name": "solid-three-monorepo",
  "description": "SolidJS bindings for ThreeJS - monorepo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solidjs-community/solid-three.git"
  },
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r build",
    "build:dev": "pnpm --filter playground build",
    "build:lib": "pnpm --filter solid-three build",
    "watch:lib": "pnpm --filter solid-three build --watch",
    "clean": "pnpm -r clean && rm -rf .turbo && rm -rf node_modules",
    "dev": "pnpm --filter playground dev",
    "lint": "pnpm --filter solid-three lint",
    "test": "pnpm -r test",
    "prepublishOnly": "pnpm --filter solid-three prepublishOnly"
  },
  "devDependencies": {
    "dpdm": "^3.14.0"
  }
}
